# Database (desenvolvimento local)
DATABASE_URL="mysql://root:password@localhost:3306/luxence_dev"

# DigitalOcean Spaces
DO_SPACES_KEY="your_spaces_key"
DO_SPACES_SECRET="your_spaces_secret"
