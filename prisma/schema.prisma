// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========== USUÁRIOS ==========

enum ROLE {
  CLIENT
  ADVERTISER
  ADMIN
}

enum GENDER {
  MALE
  FEMALE
  TRANS
}

model UserPreference {
  id      Int     @id @default(autoincrement())
  userId  Int
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  gender  GENDER

  @@unique([userId, gender])
}

model Locality {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  cep         String?
  country     String
  state       String
  city        String
  neighborhood String?
  street      String?
  number      String?
  complement  String?
}

model User {
  id          Int      @id @default(autoincrement())

  email       String   @unique
  password    String
  role        ROLE     @default(CLIENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  phone       String?
  gender      GENDER
  preferences UserPreference[]
  locality    Locality?

  // Configurações de notificação
  emailNotifications    Boolean @default(true)
  whatsappNotifications Boolean @default(false)

  // Soft delete
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?

  producer    Producer? @relation("UserProducer")

  reviews     Review[]
  comments Comment[]

  passwordResetTokens PasswordResetToken[]
  sessions    UserSession[]
  subscriptions Subscription[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())

  token     String   // token hasheado (sha256)
  expiresAt DateTime

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())

  email     String   // email a ser verificado
  token     String   // código de 6 dígitos hasheado (sha256)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model UserSession {
  id          String   @id @default(cuid())
  
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  sessionToken String  @unique
  ipAddress    String?
  userAgent    String?
  country      String?
  state        String?
  city         String?
  device       String?
  browser      String?
  os           String?
  
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  
  isActive     Boolean  @default(true)
  
  @@index([userId])
  @@index([sessionToken])
  @@index([lastActivity])
}

// ========== SISTEMA DE ASSINATURAS ==========

enum SUBSCRIPTION_STATUS {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
  SUSPENDED
}

enum PAYMENT_STATUS {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PAYMENT_METHOD {
  CREDIT_CARD
  PIX
  BOLETO
  PAYPAL
}

model SubscriptionPlan {
  id          Int      @id @default(autoincrement())
  
  signature   SIGNATURE @unique
  name        String
  description String?
  price       Decimal  @db.Decimal(10,2)
  
  // Benefícios do plano
  maxPhotos   Int      @default(0)
  maxVideos   Int      @default(0)
  maxProfileUpdates Int @default(0)
  hasCommentControl Boolean @default(false)
  hasVoiceDemo Boolean @default(false)
  priority    String?  // "", "Alta", "Máxima"
  hasFeaturedProfile Boolean @default(false)
  
  // Configurações
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  subscriptions Subscription[]
  
  @@index([signature])
}

model Subscription {
  id          String   @id @default(cuid())
  
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  planId      Int
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  
  status      SUBSCRIPTION_STATUS @default(PENDING)
  
  startDate   DateTime
  endDate     DateTime
  
  // Controle de uso
  photosUsed  Int      @default(0)
  videosUsed  Int      @default(0)
  profileUpdatesUsed Int @default(0)
  
  // Renovação automática
  autoRenew   Boolean  @default(true)
  
  // Metadados
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cancelledAt DateTime?
  
  payments    Payment[]
  usageLogs   SubscriptionUsageLog[]
  notifications SubscriptionNotification[]
  
  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@index([planId])
}

model Payment {
  id            String   @id @default(cuid())
  
  subscriptionId String
  subscription  Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  amount        Decimal  @db.Decimal(10,2)
  currency      String   @default("BRL")
  
  method        PAYMENT_METHOD
  status        PAYMENT_STATUS @default(PENDING)
  
  // Dados do pagamento
  externalId    String?  // ID do gateway de pagamento
  gatewayData   Json?    // Dados específicos do gateway
  
  // Datas
  dueDate       DateTime?
  paidAt        DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([subscriptionId])
  @@index([status])
  @@index([externalId])
}

model SubscriptionUsageLog {
  id            Int      @id @default(autoincrement())
  
  subscriptionId String
  subscription  Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  action        String   // "photo_upload", "video_upload", "profile_update"
  resourceId    String?  // ID do recurso afetado
  metadata      Json?    // Dados adicionais
  
  createdAt     DateTime @default(now())
  
  @@index([subscriptionId])
  @@index([action])
  @@index([createdAt])
}

enum NOTIFICATION_TYPE {
  WELCOME
  REMINDER
  LAST_DAY
  EXPIRED
}

model SubscriptionNotification {
  id            String   @id @default(cuid())
  
  subscriptionId String
  subscription  Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  type          NOTIFICATION_TYPE
  sentAt        DateTime @default(now())
  emailSent     Boolean  @default(true)
  metadata      Json?    // Dados adicionais como dias restantes
  
  @@unique([subscriptionId, type])
  @@index([subscriptionId])
  @@index([type])
  @@index([sentAt])
}


model Review {
  id          String   @id @default(cuid())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  profile    ProducerProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  Int

  rating      Int
  comment     String?
  reviewerName String?

  isApproved  Boolean  @default(false)
  hasComment  Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@unique([userId, profileId])
}

// ========== PRODUTOR ==========

enum SIGNATURE {
  COPPER
  SILVER
  GOLD
  DIAMOND
}

enum STATUS {
  YELLOW
  GREEN
  RED
}

model Producer {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  user        User      @relation("UserProducer", fields: [userId], references: [id], onDelete: Cascade)

  signature   SIGNATURE @default(COPPER)

  isVerified    Boolean   @default(false)
  verificationStatus STATUS @default(YELLOW)

  name        String
  birthday    DateTime
  nationality String
  document    String    @unique
  phone       String

  documentFrontPhoto  String
  documentBackPhoto   String
  selfieWithDocument  String

  profile ProducerProfile? @relation("ProducerProfileRelation")
}

model ProducerProfile {
  id          Int        @id @default(autoincrement())
  producerId  Int        @unique
  producer    Producer   @relation("ProducerProfileRelation", fields: [producerId], references: [id], onDelete: Cascade)

  name        String?
  age         Int?
  slogan      String
  description String     @db.Text
  images      Json

  scholarity  String
  languages   Json  

  hasLocal    Boolean   @default(false)
  local       ProducerLocal?

  contacts    ProducerContact[]
  appearance  ProducerAppearance[]
  prices      ProducerPrice[]
  services    ProducerService[]
  fetiches    ProducerFetish[]
  audience    ProducerAudience[]
  locations   ProducerLocation[]
  neighborhoods Json
  payments    ProducerPayment[]

  views       Int       @default(0)
  lastWeekViews Int     @default(0)
  lastWeekViewsUpdatedAt DateTime?
  profileViews ProfileView[]
  reviews     Review[]
}

//---

model ContactOption {
  id     Int    @id
  name   String @unique // whatsapp, instagram, telegram
  label  String         // WhatsApp, Instagram, Telegram
  icon   String?        // opcional (ex: "ri-whatsapp-line")

  contacts ProducerContact[]
}

model ProducerContact {
  id         Int @id @default(autoincrement())
  profileId  Int
  contactId  Int

  value      String
  label      String?
  isPrimary  Boolean @default(false)
  isPublic   Boolean @default(true)
  order      Int @default(0)

  profile    ProducerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  option     ContactOption   @relation(fields: [contactId], references: [id])

  @@unique([profileId, contactId, value])
}

model ProducerLocal {
  id         Int        @id @default(autoincrement())
  profileId  Int        @unique
  profile    ProducerProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  cep         String
  country     String
  state       String
  city        String
  neighborhood String
  street      String?
  number      String?
  complement  String?

  amenities LocalAmenity[]
}

model AmenityOption {
  id        Int @id 
  name      String @unique
  label     String

  locals    LocalAmenity[]
}

model LocalAmenity {
  id          Int @id @default(autoincrement())
  localId     Int
  amenityId   Int
  local ProducerLocal @relation(fields: [localId], references: [id], onDelete: Cascade)
  option      AmenityOption @relation(fields: [amenityId], references: [id])

  @@unique([localId, amenityId])
}

enum APPEARANCE_VALUE_TYPE {
  BOOLEAN
  NUMBER
  OPTION
}

model AppearanceOption {
  id        Int    @id
  name      String @unique
  label     String
  valueType APPEARANCE_VALUE_TYPE

  producers ProducerAppearance[]
}


model ProducerAppearance {
  id            Int @id @default(autoincrement())
  profileId     Int
  appearanceId  Int

  valueBoolean  Boolean?
  valueNumber   Float?
  valueString   String?

  profile    ProducerProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  option     AppearanceOption @relation(fields: [appearanceId], references: [id])

  @@unique([profileId, appearanceId])
}


model PriceOption {
  id       Int     @id
  name     String  @unique
  label    String
  prices   ProducerPrice[]
}

model ProducerPrice {
  id         Int             @id @default(autoincrement())
  profileId  Int
  priceId    Int
  profile    ProducerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  option     PriceOption     @relation(fields: [priceId], references: [id])
  
  value      Float           
  @@unique([profileId, priceId])
}

model PaymentOption {
  id        Int              @id
  name      String           @unique
  label     String

  payments  ProducerPayment[]
}

model ProducerPayment {
  id          Int           @id @default(autoincrement())
  profileId   Int
  paymentId   Int
  profile     ProducerProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  option      PaymentOption @relation(fields: [paymentId], references: [id])

  @@unique([profileId, paymentId])
}

model ServiceOption {
  id        Int              @id
  name      String           @unique
  label     String
  
  services  ProducerService[]
}

model ProducerService {
  id          Int           @id @default(autoincrement())
  profileId   Int
  serviceId   Int
  status      String @default("neutral")
  profile     ProducerProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  option      ServiceOption @relation(fields: [serviceId], references: [id])

  @@unique([profileId, serviceId])
}

model FetishOption {
  id        Int              @id
  name      String           @unique
  label     String

  fetiches  ProducerFetish[]
}

model ProducerFetish {
  id          Int           @id @default(autoincrement())
  profileId   Int
  fetishId    Int
  status      String @default("neutral")
  profile     ProducerProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  option      FetishOption  @relation(fields: [fetishId], references: [id])

  @@unique([profileId, fetishId])
}

model AudienceOption {
  id        Int               @id
  name      String            @unique
  label     String

  audiences ProducerAudience[]
}

model ProducerAudience {
  id          Int             @id @default(autoincrement())
  profileId   Int        
  audienceId  Int
  status      String @default("neutral")
  profile     ProducerProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  option      AudienceOption  @relation(fields: [audienceId], references: [id])
  
  @@unique([profileId, audienceId])
}

model LocationOption {
  id        Int @id
  name      String @unique
  label     String

  locations ProducerLocation[]
}

model ProducerLocation {
  id           Int @id @default(autoincrement())
  profileId    Int        
  locationId   Int
  profile      ProducerProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  option       LocationOption   @relation(fields: [locationId], references: [id])

  @@unique([profileId, locationId])
}

model Post {
  id          Int @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publishedAt DateTime @default(now())
  title       String
  imageUrl    String?
  content     String   @db.Text

  views       Int       @default(0)
  likes       Int       @default(0)
  comments    Comment[]

  @@index([createdAt(sort: Desc)])
}

model Comment {
  id          String   @id @default(cuid())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      Int

  comment     String
  likes       Int       @default(0)

  createdAt   DateTime @default(now())
}

model ProfileView {
  id        Int      @id @default(autoincrement())
  profileId Int
  viewedAt  DateTime @default(now())

  profile   ProducerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, viewedAt])
}

model HomeSliderImage {
  id          String   @id
  name        String
  url         String
  originalUrl String?

  cropX       Float?
  cropY       Float?
  cropWidth   Float?
  cropHeight  Float?
  cropZoom    Float?

  order       Int      @default(0)

  createdAt   DateTime @default(now())
}
