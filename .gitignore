# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ========================================
# Dependencies
# ========================================
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
package-lock.json
yarn.lock
pnpm-lock.yaml

# ========================================
# Environment Variables (SENSITIVE!)
# ========================================
.env
.env.*
!.env.example

# ========================================
# Next.js
# ========================================
/.next/
/out/
.next

# ========================================
# Production
# ========================================
/build
/dist

# ========================================
# Testing
# ========================================
/coverage
*.test.js.snap
.nyc_output

# ========================================
# Logs & Debug
# ========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ========================================
# OS Files
# ========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ========================================
# IDE & Editors
# ========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ========================================
# Certificates & Keys (SENSITIVE!)
# ========================================
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
*.keystore

# ========================================
# Database (SENSITIVE!)
# ========================================
prisma/dev.db
prisma/dev.db-journal
*.sqlite
*.sqlite3
*.db

# ========================================
# Docker
# ========================================
docker-compose.override.yml
.dockerignore

# ========================================
# TypeScript
# ========================================
*.tsbuildinfo
next-env.d.ts

# ========================================
# Vercel
# ========================================
.vercel

# ========================================
# Temporary Files
# ========================================
*.tmp
*.temp
.cache
.parcel-cache
.turbo

# ========================================
# Backup Files
# ========================================
*.bak
*.backup
*.old
*~

# ========================================
# Uploads & User Content (SENSITIVE!)
# ========================================
/uploads
/public/uploads
/storage
/tmp

# ========================================
# Secrets & Credentials (SENSITIVE!)
# ========================================
secrets.json
credentials.json
service-account.json
.secrets
.credentials

