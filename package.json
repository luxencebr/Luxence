{
  "name": "exence-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && NODE_OPTIONS='--max-old-space-size=4096' next build",
    "build:analyze": "ANALYZE=true npm run build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "docker-compose up -d",
    "db:stop": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d && npx prisma migrate deploy && npx prisma db seed",
    "db:migrate": "npx prisma migrate deploy",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "db:push": "npx prisma db push",
    "create-admin": "ts-node scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@prisma/client": "^6.18.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.2.3",
    "lucide-react": "0.555.0",
    "next": "^15.5.9",
    "next-auth": "^5.0.0-beta.30",
    "path": "0.12.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-easy-crop": "^5.5.6",
    "react-icons": "^5.5.0",
    "react-range": "^1.10.0",
    "resend": "^6.7.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "3.4.0",
    "tailwindcss-animate": "1.0.7",
    "url": "0.11.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.5",
    "postcss": "8.5.6",
    "prisma": "^6.18.0",
    "tailwindcss": "4.1.17",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
